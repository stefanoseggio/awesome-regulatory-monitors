{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023", "DOM"],
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": true
    },
    "include": ["lib/**/*.ts", "global-regtech-compliance-feed/**/*.ts", "latam-global-tender-intelligence/**/*.ts", "global-corporate-patent-intelligence/**/*.ts", "test/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
